# ---- Go ----
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# layat バイナリ（`go build` / `go build ./...` がリポジトリ直下に生成する）
/layat

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Go workspace file
go.work
go.work.sum

# Dependency directories（vendoring する場合はコメントアウト）
# vendor/

# ---- Nix ----
# nix build の out-link
/result
result-*

# ---- Project ----
.agents/
# `/*`（中身のみ）だと .claude/skills 自体が symlink のとき（worktrunk の
# symlink-ignored hook や layat のディレクトリ配置）untracked に出るため、パスごと ignore する
.claude/skills

# layat ドッグフーディング配置物（layat apply default で生成・→ Issue #7）
/.layat-example/
